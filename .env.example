# DHARA platform environment template.
#
# Copy this to `.env` and fill in real values. The actual, populated `.env` for
# THIS deployment (dhara-platform-rg, Azure for Students subscription) is
# generated automatically by `scripts/export-env.sh` after `az deployment group
# create` succeeds -- you should not need to hand-fill most of these.
#
# See docs/azure-requirements.md for exactly where every one of these values
# comes from in the Azure Portal / CLI, and why the service needs it.

# --- Core ---
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Postgres (Azure Database for PostgreSQL Flexible Server) ---
DATABASE_URL=postgresql+psycopg://dhara_admin:CHANGEME@localhost:5432/dhara

# --- Azure IoT Hub ---
IOT_HUB_CONNECTION_STRING=
IOT_HUB_EVENTHUB_COMPATIBLE_ENDPOINT=
IOT_HUB_EVENTHUB_CONSUMER_GROUP=$Default
IOT_HUB_NAME=
DPS_ID_SCOPE=

# --- Azure Storage ---
STORAGE_ACCOUNT_CONNECTION_STRING=
STORAGE_CONTAINER_PHOTOS=advisory-photos
STORAGE_CONTAINER_FIRMWARE=firmware

# --- Azure Key Vault ---
KEY_VAULT_URI=

# --- Azure Communication Services ---
ACS_CONNECTION_STRING=
ACS_WHATSAPP_CHANNEL_REGISTRATION_ID=
ACS_SENDER_PHONE_NUMBER=

# --- Azure OpenAI (advisory NLU) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=dhara-advisory-gpt
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Azure AI Speech ---
SPEECH_KEY=
SPEECH_REGION=

# --- Auth ---
API_SHARED_SECRET=dev-only-change-me
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=

# --- Application Insights ---
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Service-to-service URLs (set automatically after Container App deploy) ---
API_BASE_URL=http://localhost:8000
ADVISORY_BOT_URL=http://localhost:8100
ADVISORY_BOT_PUBLIC_URL=

# --- Business rules ---
CONTROL_LOOP_INTERVAL_MINUTES=15
SEASONAL_VOLUMETRIC_CAP_M3_PER_HA=6500
ADVISORY_CONFIDENCE_THRESHOLD=0.72

# --- Edge simulator ---
SIMULATOR_TICK_SECONDS=60
